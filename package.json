{
  "name": "static-jp-postal",
  "version": "0.0.0",
  "description": "Static JP postal",
  "author": "Frourio Inc.",
  "license": "MIT",
  "bin": "bin/index.js",
  "scripts": {
    "dev": "npm run build && node bin/index.js -o docs/api",
    "build": "npm run rimraf && tsc",
    "rimraf": "node -e \"require('fs').existsSync('dist') && require('fs').rmSync('dist', { recursive: true })\"",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "homepage": "https://github.com/frouriolabs/static-jp-postal#readme",
  "repository": {
    "type": "git",
    "url": "git@github.com:frouriolabs/static-jp-postal.git"
  },
  "bugs": {
    "url": "https://github.com/frouriolabs/static-jp-postal/issues"
  },
  "files": [
    "assets",
    "dist"
  ],
  "keywords": [
    "typescript"
  ],
  "dependencies": {
    "iconv-lite": "^0.7.3"
  },
  "devDependencies": {
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "typescript": "^5.0.4",
    "vitest": "^5.0.3"
  }
}
